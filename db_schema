CREATE OR REPLACE TABLE dim_order_date AS
SELECT
    TO_NUMBER(TO_CHAR(OrderDate, 'YYYYMMDD')) as iddim_order_date,
    CAST(OrderDate AS DATE) as timestamp,
    DATE_PART(day, OrderDate) as day,
    DATE_PART(dow, OrderDate) + 1 as dayOfWeek,
    CASE DATE_PART(dow, OrderDate) + 1
        WHEN 1 THEN 'Pondelok'
        WHEN 2 THEN 'Utorok'
        WHEN 3 THEN 'Streda'
        WHEN 4 THEN 'Štvrtok'
        WHEN 5 THEN 'Piatok'
        WHEN 6 THEN 'Sobota'
        WHEN 7 THEN 'Nedeľa'
    END as dayOfWeekString,
    DATE_PART(week, OrderDate) as week,
    'Week ' || DATE_PART(week, OrderDate) as weekString,
    DATE_PART(month, OrderDate) as month,
    CASE DATE_PART(month, OrderDate)
        WHEN 1 THEN 'Január'
        WHEN 2 THEN 'Február'
        WHEN 3 THEN 'Marec'
        WHEN 4 THEN 'Apríl'
        WHEN 5 THEN 'Máj'
        WHEN 6 THEN 'Jún'
        WHEN 7 THEN 'Júl'
        WHEN 8 THEN 'August'
        WHEN 9 THEN 'September'
        WHEN 10 THEN 'Október'
        WHEN 11 THEN 'November'
        WHEN 12 THEN 'December'
    END as monthString,
    DATE_PART(quarter, OrderDate) as quarter,
    DATE_PART(year, OrderDate) as year
FROM Orders_staging
GROUP BY OrderDate;

CREATE OR REPLACE TABLE dim_order_time AS
SELECT 
    ROW_NUMBER() OVER (ORDER BY full_time) as iddim_order_time,
    full_time as timestamp,
    hour,
    minute,
    second,
    CASE 
        WHEN hour < 12 THEN 'AM'
        ELSE 'PM'
    END as ampm
FROM (
    SELECT DISTINCT
        TO_TIME(OrderDate) as full_time,
        HOUR(OrderDate) as hour,
        MINUTE(OrderDate) as minute,
        SECOND(OrderDate) as second
    FROM Orders_staging
    WHERE TO_TIME(OrderDate) IS NOT NULL
);


CREATE OR REPLACE TABLE dim_employees AS
SELECT 
    EmployeeID,
    LastName,
    FirstName,
    BirthDate
FROM Employees_staging;

CREATE OR REPLACE TABLE dim_products AS
SELECT 
    p.ProductID,
    p.ProductName,
    p.Unit,
    p.Price,
    c.CategoryName as Category
FROM Products_staging p
JOIN Categories_staging c ON p.CategoryID = c.CategoryID;

CREATE OR REPLACE TABLE dim_suppliers AS
SELECT 
    SupplierID,
    SupplierName,
    ContactName,
    Address,
    City,
    PostalCode,
    Country,
    Phone
FROM Suppliers_staging;

CREATE OR REPLACE TABLE dim_shippers AS
SELECT 
    ShipperID,
    ShipperName,
    Phone
FROM Shippers_staging;

CREATE OR REPLACE TABLE dim_customers AS
SELECT 
    CustomerID,
    CustomerName,
    ContactName,
    Address,
    City,
    PostalCode,
    Country
FROM Customers_staging;

CREATE OR REPLACE TABLE facts_orderdetails AS
SELECT 
    od.OrderDetailID as fact_orderDetailID,
    od.OrderID,
    od.Quantity,
    od.Quantity * p.Price as OverallPrice,
    o.OrderDate,
    TO_NUMBER(TO_CHAR(o.OrderDate, 'YYYYMMDD')) as dim_order_date_iddim_order_date,
    t.iddim_order_time as dim_order_time_iddim_order_time,
    o.EmployeeID as dim_employees_EmployeeID,
    od.ProductID as dim_products_ProductID,
    p.SupplierID as dim_suppliers_SupplierID,
    o.ShipperID as dim_shippers_ShipperID,
    o.CustomerID as dim_customers_CustomerID
FROM OrderDetails_staging od
JOIN Orders_staging o ON od.OrderID = o.OrderID
JOIN Products_staging p ON od.ProductID = p.ProductID
JOIN dim_order_time t ON TO_TIME(o.OrderDate) = t.timestamp;

